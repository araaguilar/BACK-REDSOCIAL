    <UserSecretsId>ef5051e4-5a70-40e7-8969-963f12ebb633</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
