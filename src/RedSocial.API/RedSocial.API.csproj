      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedSocial.Infrastructure\RedSocial.Infrastructure.csproj" />
  </ItemGroup>

</Project>
